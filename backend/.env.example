# Application Settings
PROJECT_NAME="AI-Based Inventory Replenishment & Supplier Decision Support System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase PostgreSQL Database Connection
# Note: On IPv4 networks, use the Supabase Connection Pooler (port 5432 session mode or 6543 transaction mode).
# Project region for voexbbepjhvukvzpxmis: ap-northeast-2
# Replace [YOUR-PASSWORD] with your actual Supabase database password in your local .env
DATABASE_URL=postgresql+psycopg://postgres.voexbbepjhvukvzpxmis:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# JWT Authentication
# Generate a secure 256-bit random key in production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Document Management & Storage
DOCUMENT_STORAGE_DIR="storage/documents"
MAX_PDF_UPLOAD_SIZE_MB=10

# Grok LLM Configuration (Standardized Production LLM)
GROK_API_KEY=your-xai-grok-api-key-here
GROK_MODEL=grok-beta
GROK_API_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_SECONDS=15
