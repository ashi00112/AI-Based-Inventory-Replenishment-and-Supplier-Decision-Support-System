# Application Settings
PROJECT_NAME="AI-Based Inventory Replenishment & Supplier Decision Support System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase PostgreSQL Database Connection
# Replace [YOUR-PASSWORD] with your actual Supabase database password in your local .env
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.voexbbepjhvukvzpxmis.supabase.co:5432/postgres?sslmode=require

# Supabase Connection Pooler alternative (port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.voexbbepjhvukvzpxmis:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT Authentication
# Generate a secure 256-bit random key in production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

